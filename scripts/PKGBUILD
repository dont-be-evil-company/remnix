package() {
    if [[ "$CARCH" == "x86_64" ]]; then
        install -Dm755 "${srcdir}/remnix-linux-amd64" "${pkgdir}/usr/bin/remnix"
        install -Dm755 "${srcdir}/remnix-attach-linux-amd64" "${pkgdir}/usr/bin/remnix-attach"
    else
        install -Dm755 "${srcdir}/remnix-linux-arm64" "${pkgdir}/usr/bin/remnix"
        install -Dm755 "${srcdir}/remnix-attach-linux-arm64" "${pkgdir}/usr/bin/remnix-attach"
    fi
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

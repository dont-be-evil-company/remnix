  "remnix-attach-linux-amd64::https://github.com/dont-be-evil-company/remnix/releases/download/v${pkgver}/remnix-attach-linux-amd64"
)
source_aarch64=(
  "remnix-linux-arm64::https://github.com/dont-be-evil-company/remnix/releases/download/v${pkgver}/remnix-linux-arm64"
  "remnix-attach-linux-arm64::https://github.com/dont-be-evil-company/remnix/releases/download/v${pkgver}/remnix-attach-linux-arm64"
